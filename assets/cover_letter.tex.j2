% One-page cover letter sharing the resume's header and typography.
% Rendered by scripts/render.py.
\documentclass[11pt,letterpaper]{extarticle}
\usepackage[margin=<< margin >>in]{geometry}
\usepackage{xcolor}
\definecolor{linkblue}{RGB}{5,99,193}
\definecolor{rulegray}{RGB}{70,70,70}
\usepackage[colorlinks=true,urlcolor=linkblue,linkcolor=linkblue,pdfborder={0 0 0}]{hyperref}
\IfFileExists{ulem.sty}{\usepackage[normalem]{ulem}}{\newcommand{\uline}[1]{##1}}
% Carlito = Calibri metrics; fall back to Helvetica so the build never dies.
\IfFileExists{carlito.sty}
  {\usepackage[sfdefault]{carlito}}
  {\usepackage[T1]{fontenc}\usepackage[scaled=0.92]{helvet}\renewcommand{\familydefault}{\sfdefault}}
% No fi/fl ligatures: they extract as single Unicode glyphs and break naive
% ATS keyword matching.
\IfFileExists{microtype.sty}{\usepackage{microtype}\DisableLigatures{encoding = *, family = *}}{}
\pagestyle{empty}
\linespread{1.08}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{2em}
\hyphenpenalty=3000

\begin{document}

%% ---- Header: identical to the resume so the two read as one application ----
\begin{center}
  {\LARGE\bfseries\MakeUppercase{<< contact.name >>}}\\[0.35em]
  << contact_line1 >><% if contact_line2 %>\\[0.15em]
  << contact_line2 >><% endif %>
\end{center}
\vspace{0.4em}
{\color{rulegray}\hrule height 0.7pt}
\vspace{1.6em}

<< date >>

\vspace{1.0em}
\textbf{Re: << role_title >> at << company >>}

\vspace{1.0em}
<< salutation >>

\vspace{0.6em}
<% for p in paragraphs %>
<< p >>\par
\vspace{0.75em}
<% endfor %>

\vspace{0.6em}
<< closing >>\\[0.6em]
<< contact.name >>

\end{document}
